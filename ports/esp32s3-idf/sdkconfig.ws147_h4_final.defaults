# Full H4 acceptance: timer light/deep sleep loops plus real WS147 GPIO48 wake.
# This override intentionally disables the measurement-only profile switch.
# CONFIG_JELLYFRAME_ESP32S3_SOC_POWER_DEEP_SLEEP_ONLY is not set
CONFIG_JELLYFRAME_WS147_TOUCH_INT_GPIO=48
CONFIG_JELLYFRAME_ESP32S3_RUN_SOC_POWER_ACCEPTANCE=y
CONFIG_JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147=y
CONFIG_JELLYFRAME_ESP32S3_BOARD_ENABLE_HARDWARE=y
