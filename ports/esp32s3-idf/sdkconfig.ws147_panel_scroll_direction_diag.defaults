# Temporary acceptance diagnostic profile for WS147 direction/mapping capture.
# Keep outside A/B and production profiles; the visual acceptance gate remains
# disabled in the normal official B defaults.
CONFIG_JELLYFRAME_ESP32S3_SCROLL_BENCH_WORKLOAD_PANEL=y
CONFIG_JELLYFRAME_ESP32S3_USE_PACKED_RGB565_SINK=y
CONFIG_JELLYFRAME_WS147_PANEL_SCROLL_ACCELERATION=y
CONFIG_JELLYFRAME_WS147_PANEL_SCROLL_VISUAL_ACCEPTED=y
CONFIG_JELLYFRAME_WS147_PANEL_SCROLL_DIRECTION_DIAGNOSTICS=y
