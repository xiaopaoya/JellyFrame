# Phase D B experiment: same fixture as A, with the opt-in JD9853 physical
# GRAM ring callback. The 2026-09-11 retest found lower-edge row displacement;
# keep the visual acceptance gate disabled until TE/vblank synchronization is
# implemented and revalidated. This profile is not a release configuration.
CONFIG_JELLYFRAME_ESP32S3_SCROLL_BENCH_WORKLOAD_PANEL=y
CONFIG_JELLYFRAME_ESP32S3_USE_PACKED_RGB565_SINK=y
CONFIG_JELLYFRAME_WS147_PANEL_SCROLL_ACCELERATION=y
# CONFIG_JELLYFRAME_WS147_PANEL_SCROLL_VISUAL_ACCEPTED is not set
