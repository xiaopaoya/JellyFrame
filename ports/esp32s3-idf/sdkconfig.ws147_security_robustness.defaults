# Security-retention profile is standalone: it must not inherit a worktree
# sdkconfig which can silently disable the Device Image endpoint.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_CONSOLE_NONE=y
# CONFIG_ESP_CONSOLE_USB_CDC is not set
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb_n16r8.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_16mb_n16r8.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_JELLYFRAME_BENCH_VIEWPORT_WIDTH=172
CONFIG_JELLYFRAME_BENCH_VIEWPORT_HEIGHT=320
CONFIG_JELLYFRAME_ESP32S3_RUN_DEVICE_IMAGE_LIFECYCLE_ACCEPTANCE=y
CONFIG_JELLYFRAME_ESP32S3_ENABLE_SCRIPT_TASK_RUNTIME=y
CONFIG_JELLYFRAME_ESP32S3_UI_TASK_STACK_SIZE=32768
CONFIG_JELLYFRAME_ESP32S3_SCRIPT_TASK_STACK_SIZE=24576
CONFIG_JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147=y
CONFIG_JELLYFRAME_ESP32S3_BOARD_ENABLE_HARDWARE=y
CONFIG_JELLYFRAME_WS147_LCD_DMA_ROWS=8
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
