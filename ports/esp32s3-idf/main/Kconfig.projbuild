menu "JellyFrame ESP32-S3 benchmark"

choice JELLYFRAME_ESP32S3_RUN_MODE
    prompt "Startup run mode"
    default JELLYFRAME_ESP32S3_RUN_BENCHMARK
    help
        Select whether app_main runs the one-shot benchmark/smoke path or
        starts the reusable JellyFrame UI task skeleton.

config JELLYFRAME_ESP32S3_RUN_BENCHMARK
    bool "Run benchmark and smoke validations"

config JELLYFRAME_ESP32S3_RUN_TIMER_UI_TASK
    bool "Start Timer UI task"
    help
        Starts a FreeRTOS UI task that loads /timer.html from the resource
        bundle, dispatches bounded board input events, updates the timer once
        per second and publishes port telemetry.

config JELLYFRAME_ESP32S3_RUN_SCROLL_BENCHMARK
    bool "Run retained scroll benchmark"
    help
        Starts a deterministic 30 Hz scrolling list workload. It reuses the
        retained render/layout trees, resolves one overflow:auto container and
        presents only that visible container region. It is a measured board
        workload, not a production scroll-shell implementation.

endchoice

config JELLYFRAME_ESP32S3_UI_TASK_STACK_SIZE
    int "UI task stack size"
    depends on JELLYFRAME_ESP32S3_RUN_TIMER_UI_TASK || JELLYFRAME_ESP32S3_RUN_SCROLL_BENCHMARK
    default 32768
    range 8192 65536
    help
        Stack size for the JellyFrame UI task. Bring-up defaults keep this high
        until stack high-water logs are reviewed on real hardware.

config JELLYFRAME_ESP32S3_UI_TASK_PRIORITY
    int "UI task priority"
    depends on JELLYFRAME_ESP32S3_RUN_TIMER_UI_TASK || JELLYFRAME_ESP32S3_RUN_SCROLL_BENCHMARK
    default 5
    range 1 24

config JELLYFRAME_ESP32S3_UI_TASK_TICK_MS
    int "UI task idle tick delay in ms"
    depends on JELLYFRAME_ESP32S3_RUN_TIMER_UI_TASK || JELLYFRAME_ESP32S3_RUN_SCROLL_BENCHMARK
    default 20
    range 1 1000

config JELLYFRAME_ESP32S3_TIMER_UI_AUTOSTART
    bool "Start Timer UI in running state"
    depends on JELLYFRAME_ESP32S3_RUN_TIMER_UI_TASK
    default n
    help
        Test-only switch for retained-text performance captures. Production
        bring-up profiles keep this disabled so the Timer waits for a real
        pointer/touch event before running.

config JELLYFRAME_ESP32S3_SCROLL_BENCH_STEP_PIXELS
    int "Scroll benchmark step in pixels"
    depends on JELLYFRAME_ESP32S3_RUN_SCROLL_BENCHMARK
    default 6
    range 1 32
    help
        Vertical offset applied every 33 ms by the deterministic scroll workload.
        Keep it smaller than the visible scroll region for partial present data.

config JELLYFRAME_ESP32S3_SCROLL_AUTORUN
    bool "Automatically advance the scroll workload"
    depends on JELLYFRAME_ESP32S3_RUN_SCROLL_BENCHMARK
    default y
    help
        Keeps the deterministic benchmark moving at 30 Hz. Disable this for
        the interactive on-device demo; touch dragging remains enabled in
        either mode.

choice JELLYFRAME_ESP32S3_SCROLL_BENCH_WORKLOAD
    prompt "Retained scroll benchmark workload"
    depends on JELLYFRAME_ESP32S3_RUN_SCROLL_BENCHMARK
    default JELLYFRAME_ESP32S3_SCROLL_BENCH_WORKLOAD_FULL
    help
        Select one controlled workload at a time. All variants use the same
        visible scroll area, content extent and 30 Hz step policy, so their
        compose_ms_per_flush values can identify whether text, rounded cards
        or static background painting dominates the measured board cost.

config JELLYFRAME_ESP32S3_SCROLL_BENCH_WORKLOAD_FULL
    bool "Full list: text, rounded cards and background"

config JELLYFRAME_ESP32S3_SCROLL_BENCH_WORKLOAD_TEXT
    bool "Text-only list"

config JELLYFRAME_ESP32S3_SCROLL_BENCH_WORKLOAD_CARDS
    bool "Rounded-card-only list"

config JELLYFRAME_ESP32S3_SCROLL_BENCH_WORKLOAD_BACKGROUND
    bool "Background-only scroll extent"

config JELLYFRAME_ESP32S3_SCROLL_BENCH_WORKLOAD_CLEAR
    bool "Transparent clear-and-clip baseline"

config JELLYFRAME_ESP32S3_SCROLL_BENCH_WORKLOAD_PANEL
    bool "Full-screen opaque panel-scroll A/B fixture"
    help
        Uses one full 172x320 rectangular overflow viewport with no indicator,
        rounded corners, transparent pixels or overlapping UI. It is the only
        valid workload for the experimental WS147 physical-GRAM scroll path.

endchoice

config JELLYFRAME_WS147_PANEL_SCROLL_ACCELERATION
    bool "Experimental WS147 physical-GRAM scroll A/B path"
    depends on JELLYFRAME_ESP32S3_RUN_SCROLL_BENCHMARK && JELLYFRAME_ESP32S3_SCROLL_BENCH_WORKLOAD_PANEL && JELLYFRAME_ESP32S3_BOARD_ENABLE_HARDWARE && JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default n
    help
        Experimental, disabled-by-default A/B path for the Waveshare 1.47
        JD9853 panel. Each eligible scroll step sends only the unique exposed
        full-width strip through the verified physical GRAM ring mapping.
        Any mixed dirty update, invalid viewport, callback error or panel
        uncertainty immediately resets the scroll address and falls back to
        the normal framebuffer scroll-blit present path.

config JELLYFRAME_BENCH_CARD_COUNT
    int "Synthetic card count"
    default 40
    range 1 400
    help
        Number of synthetic card nodes generated for parser, style and layout
        benchmarks.

config JELLYFRAME_BENCH_ITERATIONS
    int "Benchmark iterations"
    default 20
    range 1 5000
    help
        Number of iterations used for each measured stage.

config JELLYFRAME_BENCH_VIEWPORT_WIDTH
    int "Viewport width"
    default 300
    range 64 800

config JELLYFRAME_BENCH_VIEWPORT_HEIGHT
    int "Viewport height"
    default 300
    range 64 800

config JELLYFRAME_BENCH_PRESENT_RGB565
    bool "Benchmark RGB565 framebuffer presentation"
    default y
    help
        Converts the rendered RGBA framebuffer into a host-owned RGB565 buffer
        through the embedded framebuffer HAL adapter.

endmenu

menu "JellyFrame ESP32-S3 board support"

config JELLYFRAME_ESP32S3_BOARD_ENABLE_HARDWARE
    bool "Enable physical board display/touch drivers"
    default n
    help
        Enables board-local hardware drivers. Keep this disabled for QEMU and
        generic benchmark runs.

choice JELLYFRAME_ESP32S3_BOARD
    prompt "Physical board profile"
    depends on JELLYFRAME_ESP32S3_BOARD_ENABLE_HARDWARE
    default JELLYFRAME_ESP32S3_BOARD_GENERIC

config JELLYFRAME_ESP32S3_BOARD_GENERIC
    bool "Generic/no physical panel"

config JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    bool "Waveshare ESP32-S3-Touch-LCD-1.47"
    help
        Board-local adapter for the 172x320 JD9853 SPI LCD and AXS5106L I2C
        touch controller.

endchoice

config JELLYFRAME_WS147_LCD_WIDTH
    int "Waveshare 1.47 LCD width"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 172

config JELLYFRAME_WS147_LCD_HEIGHT
    int "Waveshare 1.47 LCD height"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 320

config JELLYFRAME_WS147_LCD_SPI_SCLK_GPIO
    int "Waveshare 1.47 LCD SPI SCLK GPIO"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 38

config JELLYFRAME_WS147_LCD_SPI_MOSI_GPIO
    int "Waveshare 1.47 LCD SPI MOSI GPIO"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 39

config JELLYFRAME_WS147_LCD_CS_GPIO
    int "Waveshare 1.47 LCD CS GPIO"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 21

config JELLYFRAME_WS147_LCD_DC_GPIO
    int "Waveshare 1.47 LCD DC GPIO"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 45

config JELLYFRAME_WS147_LCD_RST_GPIO
    int "Waveshare 1.47 LCD reset GPIO"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 40

config JELLYFRAME_WS147_LCD_BL_GPIO
    int "Waveshare 1.47 LCD backlight GPIO"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 46

config JELLYFRAME_WS147_LCD_BL_ON_LEVEL
    int "Waveshare 1.47 LCD backlight active level"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 1
    range 0 1

config JELLYFRAME_WS147_LCD_PIXEL_CLOCK_HZ
    int "Waveshare 1.47 LCD SPI pixel clock"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 80000000

config JELLYFRAME_WS147_LCD_DMA_ROWS
    int "Waveshare 1.47 LCD DMA rows"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 40
    range 1 320

config JELLYFRAME_WS147_LCD_SWAP_RGB565_BYTES
    bool "Swap RGB565 bytes before JD9853 SPI flush"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default y
    help
        JD9853 receives RGB565 over SPI in big-endian byte order. Enable this
        when colors look shifted or red/blue/green components appear wrong.

config JELLYFRAME_WS147_TOUCH_SDA_GPIO
    int "Waveshare 1.47 touch I2C SDA GPIO"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 42

config JELLYFRAME_WS147_TOUCH_SCL_GPIO
    int "Waveshare 1.47 touch I2C SCL GPIO"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 41

config JELLYFRAME_WS147_TOUCH_INT_GPIO
    int "Waveshare 1.47 touch INT GPIO"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 48

config JELLYFRAME_WS147_TOUCH_RST_GPIO
    int "Waveshare 1.47 touch reset GPIO"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 47

config JELLYFRAME_WS147_TOUCH_ADDR
    hex "Waveshare 1.47 AXS5106L I2C address"
    depends on JELLYFRAME_ESP32S3_BOARD_WAVESHARE_TOUCH_LCD_147
    default 0x63

endmenu
