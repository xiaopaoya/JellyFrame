{
  "$schema": "../../../../tools/schemas/jellyframe.app.schema.json",
  "format": "jellyframe.app",
  "formatVersion": 0,
  "id": "org.jellyframe.examples.static_modules",
  "name": "Static Modules",
  "version": {"name": "0.1.0", "code": 1},
  "entry": "/index.html",
  "runtime": {"minJellyFrame": "0.6.0", "script": "classic"},
  "viewport": {"designWidth": 300, "designHeight": 300, "shape": "round"},
  "budgets": {
    "maxResourceBytes": 32768,
    "maxDomNodes": 96,
    "maxCssRules": 48,
    "maxDisplayCommands": 120,
    "maxEventListeners": 8
  },
  "targets": {
    "round-300": {
      "viewport": {"width": 300, "height": 300, "shape": "round"},
      "output": "jfapp",
      "gate": {"policy": "accept", "minViewport": {"width": 300, "height": 300}}
    },
    "rect-320x240": {
      "viewport": {"width": 320, "height": 240, "shape": "rect"},
      "output": "jfapp",
      "gate": {"policy": "accept", "minViewport": {"width": 320, "height": 240}}
    },
    "rect-172x320": {
      "viewport": {"width": 172, "height": 320, "shape": "rect"},
      "output": "jfapp",
      "gate": {"policy": "accept", "minViewport": {"width": 172, "height": 320}}
    }
  }
}
