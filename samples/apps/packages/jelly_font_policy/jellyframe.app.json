{
  "format": "jellyframe.app",
  "formatVersion": 0,
  "id": "org.jellyframe.examples.font_policy",
  "name": "Font Policy",
  "version": {
    "name": "0.1.0",
    "code": 1
  },
  "entry": "/index.html",
  "runtime": {
    "minJellyFrame": "0.6.0",
    "minRenderCore": "0.6.1",
    "script": "none"
  },
  "viewport": {
    "designWidth": 300,
    "designHeight": 300
  },
  "budgets": {
    "maxResourceBytes": 16384,
    "maxAppFonts": 2,
    "maxAppFontBytes": 1024,
    "maxAppFontGlyphs": 12
  },
  "fonts": [
    {
      "id": "tiny-cn",
      "source": "/fonts/tiny_cn.jffont",
      "profile": "app-subset-cn",
      "family": "Jelly Tiny CN",
      "license": {
        "name": "JellyFrame sample font",
        "source": "src/render_core/samples/fonts/bitmap/tiny.bdf"
      },
      "sizes": [8, 12, 18, 36],
      "weights": [400, 700]
    },
    {
      "id": "tiny-symbols",
      "source": "/fonts/tiny_symbols.jffont",
      "profile": "tiny-plus-symbols",
      "family": "Jelly Tiny Symbols",
      "license": {
        "name": "JellyFrame sample font",
        "source": "src/render_core/samples/fonts/bitmap/tiny.bdf"
      },
      "sizes": [8, 12, 18, 36],
      "weights": [400, 700]
    }
  ],
  "targets": {
    "round-300": {
      "viewport": {
        "width": 300,
        "height": 300,
        "shape": "round"
      },
      "output": "jfapp",
      "budgets": {
        "maxAppFonts": 2,
        "maxAppFontBytes": 1024,
        "maxAppFontGlyphs": 12
      }
    }
  }
}
