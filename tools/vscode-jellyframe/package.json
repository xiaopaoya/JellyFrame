{
  "name": "jellyframe-tools",
  "displayName": "JellyFrame Tools",
  "description": "VS Code helpers for JellyFrame app packages.",
  "version": "0.2.0",
  "publisher": "jellyframe",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:jellyframe.validate",
    "onCommand:jellyframe.check",
    "onCommand:jellyframe.preview",
    "onCommand:jellyframe.debug",
    "onCommand:jellyframe.runFrameScript",
    "onCommand:jellyframe.openCapture",
    "onCommand:jellyframe.listBuilds",
    "onCommand:jellyframe.package",
    "onCommand:jellyframe.newFromTemplate",
    "onCommand:jellyframe.showReport"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jellyframe.validate",
        "title": "JellyFrame: Validate Package"
      },
      {
        "command": "jellyframe.check",
        "title": "JellyFrame: Check Package"
      },
      {
        "command": "jellyframe.preview",
        "title": "JellyFrame: Preview Package"
      },
      {
        "command": "jellyframe.debug",
        "title": "JellyFrame: Debug App In Desktop Shell"
      },
      {
        "command": "jellyframe.runFrameScript",
        "title": "JellyFrame: Run Frame Script"
      },
      {
        "command": "jellyframe.openCapture",
        "title": "JellyFrame: Open Capture"
      },
      {
        "command": "jellyframe.listBuilds",
        "title": "JellyFrame: List Desktop Builds"
      },
      {
        "command": "jellyframe.package",
        "title": "JellyFrame: Generate Resource Package"
      },
      {
        "command": "jellyframe.newFromTemplate",
        "title": "JellyFrame: New App From Template"
      },
      {
        "command": "jellyframe.showReport",
        "title": "JellyFrame: Show Last Report"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "jellyframe.status",
          "name": "JellyFrame",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "jellyframe.debug",
          "when": "view == jellyframe.status",
          "group": "navigation@1"
        },
        {
          "command": "jellyframe.showReport",
          "when": "view == jellyframe.status",
          "group": "navigation@2"
        },
        {
          "command": "jellyframe.listBuilds",
          "when": "view == jellyframe.status",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "JellyFrame",
      "properties": {
        "jellyframe.repoRoot": {
          "type": "string",
          "default": "",
          "description": "Optional JellyFrame repository root. Leave empty when running the extension from this repository."
        },
        "jellyframe.buildDir": {
          "type": "string",
          "default": "",
          "description": "Optional desktop build directory. Leave empty to prefer build/Release, then build/Debug."
        },
        "jellyframe.openCaptureAfterRun": {
          "type": "boolean",
          "default": true,
          "description": "Open the generated capture after a frame-script run when a capture is produced."
        },
        "jellyframe.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to run tools/jellyframe_cli.py."
        },
        "jellyframe.defaultTarget": {
          "type": "string",
          "default": "round-300",
          "description": "Default target preset passed to JellyFrame CLI commands."
        },
        "jellyframe.fontBudget": {
          "type": "string",
          "default": "16x16",
          "description": "Default glyph budget passed to font resource checks."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "jellyframe.app.json",
          "**/jellyframe.app.json"
        ],
        "url": "../schemas/jellyframe.app.schema.json"
      }
    ]
  }
}
