{
  "name": "jellyframe-tools",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.4.5",
  "publisher": "jellyframe",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaopaoya/JellyFrame.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:jellyframe.validate",
    "onCommand:jellyframe.check",
    "onCommand:jellyframe.preview",
    "onCommand:jellyframe.debug",
    "onCommand:jellyframe.debugExternal",
    "onCommand:jellyframe.runFrameScript",
    "onCommand:jellyframe.openCapture",
    "onCommand:jellyframe.listBuilds",
    "onCommand:jellyframe.package",
    "onCommand:jellyframe.newFromTemplate",
    "onCommand:jellyframe.showReport",
    "onCommand:jellyframe.showOutput"
    ,"onCommand:jellyframe.deviceDiscover"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jellyframe.validate",
        "title": "%command.validate%",
        "icon": "$(check)"
      },
      {
        "command": "jellyframe.check",
        "title": "%command.check%",
        "icon": "$(check-all)"
      },
      {
        "command": "jellyframe.preview",
        "title": "%command.preview%",
        "icon": "$(preview)"
      },
      {
        "command": "jellyframe.debug",
        "title": "%command.debug%",
        "icon": "$(play)"
      },
      {
        "command": "jellyframe.debugExternal",
        "title": "%command.debugExternal%",
        "icon": "$(external-link)"
      },
      {
        "command": "jellyframe.runFrameScript",
        "title": "%command.runFrameScript%",
        "icon": "$(debug-alt)"
      },
      {
        "command": "jellyframe.openCapture",
        "title": "%command.openCapture%",
        "icon": "$(open-preview)"
      },
      {
        "command": "jellyframe.listBuilds",
        "title": "%command.listBuilds%",
        "icon": "$(list-tree)"
      },
      {
        "command": "jellyframe.package",
        "title": "%command.package%",
        "icon": "$(package)"
      },
      {
        "command": "jellyframe.newFromTemplate",
        "title": "%command.newFromTemplate%",
        "icon": "$(new-file)"
      },
      {
        "command": "jellyframe.showReport",
        "title": "%command.showReport%",
        "icon": "$(output)"
      },
      {
        "command": "jellyframe.showOutput",
        "title": "%command.showOutput%",
        "icon": "$(terminal)"
      },
      {
        "command": "jellyframe.deviceDiscover",
        "title": "%command.deviceDiscover%",
        "icon": "$(plug)"
      }
    ],
    "submenus": [
      {
        "id": "jellyframe.actions",
        "label": "%menu.label%",
        "icon": "$(beaker)"
      },
      {
        "id": "jellyframe.packageActions",
        "label": "%menu.packageLabel%",
        "icon": "$(package)"
      },
      {
        "id": "jellyframe.editorActions",
        "label": "%menu.editorLabel%",
        "icon": "$(tools)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jellyframe",
          "title": "%viewContainer.title%",
          "icon": "media/jellyframe.svg"
        }
      ]
    },
    "views": {
      "jellyframe": [
        {
          "id": "jellyframe.status",
          "name": "%view.status%"
        }
      ]
    },
    "menus": {
      "jellyframe.actions": [
        {
          "command": "jellyframe.validate",
          "group": "package@1"
        },
        {
          "command": "jellyframe.check",
          "group": "package@2"
        },
        {
          "command": "jellyframe.preview",
          "group": "package@3"
        },
        {
          "command": "jellyframe.package",
          "group": "package@4"
        },
        {
          "command": "jellyframe.newFromTemplate",
          "group": "package@5"
        },
        {
          "command": "jellyframe.debug",
          "group": "debug@1"
        },
        {
          "command": "jellyframe.debugExternal",
          "group": "debug@2"
        },
        {
          "command": "jellyframe.runFrameScript",
          "group": "debug@3"
        },
        {
          "command": "jellyframe.openCapture",
          "group": "debug@4"
        },
        {
          "command": "jellyframe.listBuilds",
          "group": "debug@5"
        },
        {
          "command": "jellyframe.showReport",
          "group": "report@1"
        },
        {
          "command": "jellyframe.showOutput",
          "group": "report@2"
        },
        {
          "command": "jellyframe.deviceDiscover",
          "group": "device@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "jellyframe.packageActions",
          "when": "resourceFilename == jellyframe.app.json || resourceFilename == app.json",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "jellyframe.editorActions",
          "when": "resourceExtname == .html || resourceExtname == .css || resourceFilename == jellyframe.app.json || resourceFilename == app.json",
          "group": "navigation"
        }
      ],
      "jellyframe.packageActions": [
        {
          "command": "jellyframe.validate",
          "group": "package@1"
        },
        {
          "command": "jellyframe.check",
          "group": "package@2"
        },
        {
          "command": "jellyframe.preview",
          "group": "package@3"
        },
        {
          "command": "jellyframe.package",
          "group": "package@4"
        },
        {
          "command": "jellyframe.debug",
          "group": "debug@1"
        },
        {
          "command": "jellyframe.debugExternal",
          "group": "debug@2"
        },
        {
          "command": "jellyframe.showReport",
          "group": "report@1"
        },
        {
          "command": "jellyframe.showOutput",
          "group": "report@2"
        }
      ],
      "jellyframe.editorActions": [
        {
          "command": "jellyframe.validate",
          "group": "package@1"
        },
        {
          "command": "jellyframe.check",
          "group": "package@2"
        },
        {
          "command": "jellyframe.preview",
          "group": "package@3"
        },
        {
          "command": "jellyframe.debug",
          "group": "debug@1"
        },
        {
          "command": "jellyframe.debugExternal",
          "group": "debug@2"
        },
        {
          "command": "jellyframe.runFrameScript",
          "group": "debug@3"
        },
        {
          "command": "jellyframe.showReport",
          "group": "report@1"
        },
        {
          "command": "jellyframe.showOutput",
          "group": "report@2"
        }
      ],
      "view/title": [
        {
          "submenu": "jellyframe.actions",
          "when": "view == jellyframe.status",
          "group": "navigation@0"
        },
        {
          "command": "jellyframe.debug",
          "when": "view == jellyframe.status",
          "group": "navigation@1"
        },
        {
          "command": "jellyframe.showReport",
          "when": "view == jellyframe.status",
          "group": "navigation@2"
        },
        {
          "command": "jellyframe.listBuilds",
          "when": "view == jellyframe.status",
          "group": "navigation@3"
        },
        {
          "command": "jellyframe.showOutput",
          "when": "view == jellyframe.status",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "jellyframe.repoRoot": {
          "type": "string",
          "default": "",
          "description": "%configuration.repoRoot%"
        },
        "jellyframe.buildDir": {
          "type": "string",
          "default": "",
          "description": "%configuration.buildDir%"
        },
        "jellyframe.openCaptureAfterRun": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.openCaptureAfterRun%"
        },
        "jellyframe.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "%configuration.pythonPath%"
        },
        "jellyframe.defaultTarget": {
          "type": "string",
          "default": "round-300",
          "description": "%configuration.defaultTarget%"
        },
        "jellyframe.fontBudget": {
          "type": "string",
          "default": "16x16",
          "description": "%configuration.fontBudget%"
        },
        "jellyframe.deviceProvider": {
          "type": "string",
          "default": "",
          "description": "%configuration.deviceProvider%"
        },
        "jellyframe.deviceManifest": {
          "type": "string",
          "default": "",
          "description": "%configuration.deviceManifest%"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "jellyframe.app.json",
          "**/jellyframe.app.json"
        ],
        "url": "../schemas/jellyframe.app.schema.json"
      }
    ]
  }
}
