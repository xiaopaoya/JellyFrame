{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jellyframe.dev/schemas/jellyframe.render_core.profile.schema.json",
  "title": "JellyFrame Render Core Feature Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineAbi",
    "profileId",
    "features"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "engineAbi": {
      "type": "integer",
      "minimum": 1
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]*$"
      }
    },
    "sourceFamilies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
