+/**
+ * Create an internal property with its value initialized before a possible GC
+ * during property hashmap insertion.
+ *
+ * @return pointer to the newly created property value
+ */
+ecma_property_value_t *
+ecma_create_initialized_internal_property (ecma_object_t *object_p, /**< object */
+                                            ecma_string_t *name_p, /**< internal property name */
+                                            ecma_property_value_t value) /**< initial value */
+{
+  JERRY_ASSERT (object_p != NULL && name_p != NULL);
+  JERRY_ASSERT (ecma_find_named_property (object_p, name_p) == NULL);
+  ecma_property_t *property_p;
+  ecma_property_value_t *result_p = ecma_create_property (object_p, name_p, ECMA_PROPERTY_FLAG_DATA,
+                                                        value, &property_p);
+  JERRY_ASSERT (*property_p == ECMA_PROPERTY_INTERNAL);
+  return result_p;
+}
